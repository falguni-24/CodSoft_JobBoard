# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/jobconnect
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jobconnect

# JWT Authentication
JWT_SECRET=jobconnect_super_secret_jwt_key_development_2026_change_in_production
JWT_EXPIRES_IN=7d

# Nodemailer / SMTP Email Notification Settings
# Optional in development: if credentials are omitted, mock notifications are logged gracefully
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="JobConnect Careers" <no-reply@jobconnect.com>
